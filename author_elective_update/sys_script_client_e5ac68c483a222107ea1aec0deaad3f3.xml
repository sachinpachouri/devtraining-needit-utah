        <name>PopulateWhatNeeded</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }
	g_form.clearOptions('u_what_needed') ;
   if(newValue == 'legal'){
	g_form.addOption('u_what_needed' , 'leg1' , 'legal 1');
	g_form.addOption('u_what_needed' , 'leg2' , 'legal 2');
	g_form.addOption('u_what_needed' , 'other' , 'other');
   }

   if(newValue == 'hr'){
	g_form.addOption('u_what_needed' , 'hr1' , 'HR 1');
	g_form.addOption('u_what_needed' , 'hr2' , 'HR 2');
	g_form.addOption('u_what_needed' , 'other' , 'other');
   }

   if(newValue == 'facilities'){
	g_form.addOption('u_what_needed' , 'facilities1' , 'facilities 1');
	g_form.addOption('u_what_needed' , 'facilities2' , 'facilities 2');
	g_form.addOption('u_what_needed' , 'other' , 'other');
   }

   //Type appropriate comment here, and begin script below
   
}]]></script>
